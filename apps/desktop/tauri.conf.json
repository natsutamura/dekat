{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dekat",
  "version": "0.3.1",
  "identifier": "id.vuelabs.dekat",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Dekat",
        "width": 1080,
        "height": 680,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "publisher": "Vuelabs",
    "copyright": "© 2026 Vuelabs",
    "category": "SocialNetworking",
    "shortDescription": "Chat LAN tanpa server",
    "longDescription": "Chat, kirim file, dan panggilan suara peer-to-peer di satu jaringan lokal. Tanpa server, tanpa internet, terenkripsi TLS.",
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installerHooks": "../../packaging/nsis-hooks.nsh",
        "installMode": "currentUser",
        "languages": ["English", "Indonesian"]
      }
    }
  }
}