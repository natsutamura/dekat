{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LAN Chat",
  "version": "0.1.0",
  "identifier": "id.vuelabs.lanchat",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "LAN Chat",
        "width": 1080,
        "height": 680,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}