# Maintainer: ray <ray@vuelabs.id>
# PKGBUILD untuk Arch Linux / CachyOS.
#
# Paket ini memasang binary yang sudah dibangun (tar.gz dari GitHub Actions),
# bukan mengompilasi ulang — build Tauri butuh WebKitGTK 4.1 dan memakan
# 15+ menit. Kalau kamu mau kompilasi sendiri, ganti source=() dengan repo git
# dan isi build()/package() dengan `cargo build --release`.
pkgname=dekat-bin
pkgver=0.3.0
pkgrel=1
pkgdesc="Chat, kirim file, dan panggilan suara peer-to-peer di jaringan lokal (tanpa server)"
arch=('x86_64')
url="https://github.com/natsutamura/dekat"
license=('MIT')
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'libayatana-appindicator'
  'librsvg'
  'hicolor-icon-theme'
)
provides=('dekat')
conflicts=('dekat')
options=('!strip')   # binary sudah di-strip oleh profil release

source=("https://github.com/natsutamura/dekat/releases/download/v${pkgver}/dekat-${pkgver}-linux-x64.tar.gz")
sha256sums=('f63a8db833a9e6beaaff8fbc89802d779980377a89f1b935e1814d6f1b4f52af')

package() {
  install -Dm755 "${srcdir}/dekat-${pkgver}-linux-x64/usr/bin/dekat" \
    "${pkgdir}/usr/bin/dekat"
  install -Dm644 "${srcdir}/dekat-${pkgver}-linux-x64/usr/share/applications/dekat.desktop" \
    "${pkgdir}/usr/share/applications/dekat.desktop"
  install -Dm644 "${srcdir}/dekat-${pkgver}-linux-x64/usr/share/icons/hicolor/512x512/apps/dekat.png" \
    "${pkgdir}/usr/share/icons/hicolor/512x512/apps/dekat.png"
}